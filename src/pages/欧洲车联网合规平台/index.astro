---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>欧洲车联网合规与安全运营一站式平台 - 字特智能</title>
    <meta name="description" content="字特智能 - 欧洲车联网合规与安全运营一站式平台方案。帮助中国车企以合规、安全、可认证、可持续运营的方式顺利进入欧洲。">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">

    <style>
        /* 强制浏览器打印/导出 PDF 时保留背景色彩与黑金/深色调 */
        @media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            header.top-header {
                position: relative !important;
            }

            .page_wrapper {
                padding-top: 0 !important;
            }

            .product_hero_banner {
                background: linear-gradient(135deg, rgba(11, 23, 39, 0.96) 0%, rgba(23, 42, 69, 0.92) 100%) !important;
                color: #ffffff !important;
            }

            .product_hero_inner h1, .product_hero_inner p {
                color: #ffffff !important;
            }

            .unified_integrator_section {
                background: #0f172a !important;
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.15) !important;
            }

            .integrator_top_header h3 {
                color: #00d084 !important;
            }

            .integrator_top_header p, .case_content p {
                color: #e2e8f0 !important;
            }

            .int_box {
                background: rgba(255, 255, 255, 0.08) !important;
                border: 1px solid rgba(255, 255, 255, 0.2) !important;
            }

            .int_box h4 {
                color: #38bdf8 !important;
            }

            .int_box ul li {
                color: #f1f5f9 !important;
            }

            .case_content h4 {
                color: #ffffff !important;
            }

            .case_quick_stats {
                background: rgba(0, 0, 0, 0.4) !important;
            }

            .stat_box .num {
                color: #00d084 !important;
            }

            .stat_box .label {
                color: #cbd5e1 !important;
            }
        }

        /* 顶部 Header 占位防重叠 */
        .page_wrapper {
            padding-top: 80px;
        }

        .product_hero_banner {
            width: 100%;
            min-height: 400px;
            background: linear-gradient(135deg, rgba(11, 23, 39, 0.96) 0%, rgba(23, 42, 69, 0.92) 100%), url('/images/products/compliance/minimal_shield.jpg') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 80px 20px 50px;
            box-sizing: border-box;
        }

        .product_hero_inner {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
            text-align: center;
            z-index: 2;
        }

        .product_hero_inner h1 {
            font-size: 44px;
            font-weight: 700;
            color: #ffffff !important;
            margin-bottom: 18px;
            line-height: 1.25;
            letter-spacing: 1px;
        }

        .product_hero_inner p {
            font-size: 16.5px;
            color: rgba(255, 255, 255, 0.9) !important;
            max-width: 860px;
            margin: 0 auto;
            line-height: 1.65;
            font-weight: 300;
        }

        /* 核心指标 Pillar Bar */
        .metrics_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1200px;
            margin: 40px auto 60px;
            padding: 0 20px;
            box-sizing: border-box;
        }

        .metric_card {
            background: #ffffff !important;
            border-radius: 14px;
            padding: 32px 24px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            border-top: 4px solid #00d084;
            text-align: center;
            transition: transform 0.3s ease;
            box-sizing: border-box;
        }

        .metric_card:hover { transform: translateY(-5px); }

        .metric_value {
            font-size: 44px;
            font-weight: 800;
            color: #00a86b !important;
            line-height: 1;
            margin-bottom: 10px;
            font-family: 'Urbanist', sans-serif;
        }

        .metric_title {
            font-size: 18.5px;
            font-weight: 600;
            color: #111111 !important;
            margin-bottom: 6px;
        }

        .metric_desc {
            font-size: 13.5px;
            color: #555555 !important;
            line-height: 1.5;
        }

        .section_block {
            max-width: 1200px;
            margin: 0 auto 75px;
            padding: 0 20px;
            box-sizing: border-box;
        }

        .section_header {
            text-align: center;
            margin-bottom: 44px;
        }

        .section_header h2 {
            font-size: 35px;
            font-weight: 600;
            color: #111111 !important;
            margin-bottom: 10px;
        }

        .section_header p {
            font-size: 15.5px;
            color: #666666 !important;
        }

        /* 🌟 核心定位与真实落地案例（二合一融合大卡片，强制高对比深色调） */
        .unified_integrator_section {
            background: #0f172a !important;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
            border-radius: 20px;
            padding: 48px;
            color: #ffffff !important;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.12);
            margin-bottom: 70px;
            box-sizing: border-box;
        }

        .integrator_top_header h3 {
            font-size: 28px;
            font-weight: 700;
            color: #00d084 !important;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .integrator_top_header p {
            font-size: 15.5px;
            color: #f1f5f9 !important;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .integrator_grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 44px;
        }

        .int_box {
            background: rgba(255, 255, 255, 0.06) !important;
            border-radius: 14px;
            padding: 26px;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-sizing: border-box;
        }

        .int_box h4 {
            font-size: 18px;
            font-weight: 600;
            color: #38bdf8 !important;
            margin-bottom: 14px;
        }

        .int_box ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .int_box ul li {
            font-size: 14px;
            color: #e2e8f0 !important;
            margin-bottom: 10px;
            padding-left: 18px;
            position: relative;
            line-height: 1.5;
        }

        .int_box ul li strong {
            color: #ffffff !important;
        }

        .int_box ul li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: #38bdf8 !important;
            font-size: 18px;
        }

        /* 融合的案例部分 */
        .integrated_case_divider {
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding-top: 40px;
            margin-top: 10px;
        }

        .case_flex {
            display: flex;
            align-items: center;
            gap: 36px;
        }

        .case_thumb {
            width: 440px;
            max-width: 100%;
            flex-shrink: 0;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        }

        .case_thumb img {
            width: 100%;
            height: auto;
            display: block;
        }

        .case_content {
            flex: 1;
            min-width: 0;
        }

        .case_badge {
            display: inline-block;
            background: rgba(0, 208, 130, 0.25) !important;
            color: #00d084 !important;
            font-size: 13px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
            border: 1px solid rgba(0, 208, 130, 0.4) !important;
        }

        .case_content h4 {
            font-size: 24px;
            color: #ffffff !important;
            margin-bottom: 12px;
            line-height: 1.35;
            font-weight: 700;
        }

        .case_content p {
            font-size: 14.5px;
            color: #cbd5e1 !important;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .case_content p strong {
            color: #ffffff !important;
        }

        .case_quick_stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            background: rgba(0, 0, 0, 0.35) !important;
            padding: 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            box-sizing: border-box;
        }

        .stat_box { text-align: center; }
        .stat_box .num {
            font-size: 24px;
            font-weight: 700;
            color: #00d084 !important;
            font-family: 'Urbanist', sans-serif;
        }
        .stat_box .label {
            font-size: 12px;
            color: #94a3b8 !important;
            margin-top: 2px;
        }

        /* 痛点 vs 核心主张 */
        .pain_claim_grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .pain_box {
            background: #fff5f5 !important;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #ff4d4f;
            box-sizing: border-box;
        }

        .claim_box {
            background: #f0f7ff !important;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #00d084;
            box-sizing: border-box;
        }

        .box_title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .pain_box .box_title { color: #cf1322 !important; }
        .claim_box .box_title { color: #00a86b !important; }

        .item_list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .item_list li {
            font-size: 14.5px;
            line-height: 1.65;
            margin-bottom: 12px;
            color: #333333 !important;
            position: relative;
            padding-left: 22px;
        }

        .pain_box .item_list li::before {
            content: "✕";
            position: absolute;
            left: 0;
            color: #ff4d4f !important;
            font-weight: bold;
        }

        .claim_box .item_list li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #00d084 !important;
            font-weight: bold;
        }

        /* 监管时钟时间轴 */
        .timeline_container {
            background: #ffffff !important;
            border-radius: 16px;
            padding: 38px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid #eee;
            box-sizing: border-box;
        }

        .timeline_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .timeline_item {
            background: #f8fafc !important;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #00d084;
            box-sizing: border-box;
        }

        .timeline_date {
            font-size: 13px;
            font-weight: 700;
            color: #00a86b !important;
            margin-bottom: 6px;
            font-family: 'Urbanist', sans-serif;
        }

        .timeline_title {
            font-size: 17px;
            font-weight: 600;
            color: #111111 !important;
            margin-bottom: 6px;
        }

        .timeline_desc {
            font-size: 12.5px;
            color: #666666 !important;
            line-height: 1.5;
        }

        /* 3 大商业套餐 */
        .package_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .package_card {
            background: #ffffff !important;
            border-radius: 16px;
            padding: 34px 26px;
            border: 2px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .package_card.popular {
            border-color: #00d084;
            box-shadow: 0 12px 35px rgba(0, 208, 130, 0.15);
        }

        .popular_badge {
            position: absolute;
            top: 16px;
            right: -32px;
            background: #00d084;
            color: #fff !important;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 36px;
            transform: rotate(45deg);
        }

        .pkg_header h3 {
            font-size: 21px;
            font-weight: 700;
            color: #0f172a !important;
            margin-bottom: 6px;
        }

        .pkg_sub {
            font-size: 13px;
            color: #2a55e5 !important;
            font-weight: 600;
            margin-bottom: 14px;
            display: block;
        }

        .pkg_stage {
            display: inline-block;
            background: #f1f5f9 !important;
            color: #475569 !important;
            font-size: 12px;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 18px;
        }

        .pkg_list {
            list-style: none;
            padding: 0;
            margin: 0 0 20px 0;
        }

        .pkg_list li {
            font-size: 13.5px;
            color: #334155 !important;
            margin-bottom: 10px;
            padding-left: 18px;
            position: relative;
            line-height: 1.5;
        }

        .pkg_list li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #00d084 !important;
            font-weight: bold;
        }

        /* 为什么选择我们：对比表格 Matrix */
        .compare_table_wrapper {
            overflow-x: auto;
            background: #ffffff !important;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid #eee;
        }

        .compare_table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            min-width: 650px;
        }

        .compare_table th, .compare_table td {
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
            font-size: 14.5px;
        }

        .compare_table th {
            background: #fafafa !important;
            font-weight: 600;
            color: #111111 !important;
        }

        .compare_table td.our_service {
            background: #f0fdf4 !important;
            color: #00a86b !important;
            font-weight: 600;
        }

        @media (max-width: 992px) {
            .integrator_grid { grid-template-columns: 1fr; }
            .case_flex { flex-direction: column; }
            .case_thumb { width: 100%; }
            .metrics_grid { grid-template-columns: 1fr; margin-top: 30px; }
            .pain_claim_grid { grid-template-columns: 1fr; }
            .package_grid { grid-template-columns: 1fr; }
            .timeline_grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            .product_hero_inner h1 { font-size: 30px; }
            .unified_integrator_section { padding: 24px; }
            .case_quick_stats { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body class="wp-singular page-template page-template-page-products page-template-page-products-php page wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部 Header 导航栏 -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li class="menu-item"><a href="/">首页</a></li>
                    <li class="menu-item"><a href="/核心产品/">核心产品</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/数智化服务/">数智化服务</a></li>
                    <li class="menu-item"><a href="/资讯中心/">资讯中心</a></li>
                    <li class="menu-item"><a href="/关于我们/">关于我们</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/eu-compliance/" selected>简体中文</option>
                        <option value="/en/eu-compliance/">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="page_wrapper">
        <!-- Hero 头部 Banner -->
        <section class="product_hero_banner">
            <div class="product_hero_inner">
                <h1>欧洲车联网合规与安全运营一站式平台</h1>
                <p>
                    帮中国车企以合规、安全、可认证、可持续运营的方式顺利进入欧洲市场。<br>
                    拒绝单纯“交 PDF 报告”的普通咨询，提供合规体系搭建 + 平台能力建设 + 认证证据编排 + 安全运营托管的全闭环能力。
                </p>
            </div>
        </section>

        <!-- 3 大核心量化指标 Pillar Bar -->
        <div class="metrics_grid">
            <div class="metric_card">
                <div class="metric_value">100%</div>
                <div class="metric_title">合规法规覆盖</div>
                <div class="metric_desc">全覆盖 UN R155/R156、GDPR、EU Data Act 及 EU AI Act 规制</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">0 违规</div>
                <div class="metric_title">主机厂交付记录</div>
                <div class="metric_desc">数据平台合规整改与车联网平台托管持续零违规安全运营</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">1 站式</div>
                <div class="metric_title">总集成商交付</div>
                <div class="metric_desc">减少 OEM 跨供应商沟通熵增与责任甩锅，直接提供可审计证据包</div>
            </div>
        </div>

        <!-- 🌟【核心定位 ＋ 真实客户案例一体化 Banner】：放在最前面，高对比深色调 -->
        <section class="section_block">
            <div class="unified_integrator_section">
                <!-- 上半部分：合规总集成商核心定位 -->
                <div class="integrator_top_header">
                    <h3>我们的定位：中国车企出海欧洲的“车联网合规与安全运营总集成商”</h3>
                    <p>
                        客户只需面对字特智能一家，即可拿到全套型式认证可用的证据链，并获得长期可持续的本地化安全运营服务。
                    </p>
                </div>

                <div class="integrator_grid">
                    <div class="int_box">
                        <h4>自有核心能力（已验证落地）</h4>
                        <ul>
                            <li><strong>中德双边法律意见</strong>：自有中德律师团队出具正式法律意见。</li>
                            <li><strong>数据平台合规整改与运维</strong>：已有真实主机厂交付闭环。</li>
                            <li><strong>合规控制项库与证据管理</strong>：数字化管理 OEM 审计证据包。</li>
                            <li><strong>总集成编排</strong>：统一调度车端、云、OTA 与认证资源。</li>
                        </ul>
                    </div>

                    <div class="int_box">
                        <h4>合作伙伴深度交付（我方总集成）</h4>
                        <ul>
                            <li><strong>R155 / CSMS</strong>：技术构建与 TARA 威胁分析。</li>
                            <li><strong>R156 / OTA</strong>：底层平台合规与更新追溯。</li>
                            <li><strong>VSOC 运营</strong>：SOC / IDS / SIEM 安全监测与事件响应。</li>
                            <li><strong>认证通道对接</strong>：TÜV、DEKRA、VCA、KBA、TISAX。</li>
                        </ul>
                    </div>
                </div>

                <!-- 下半部分：一体化的真实客户落地实绩案例 -->
                <div class="integrated_case_divider">
                    <div class="case_flex">
                        <div class="case_thumb">
                            <img src="/images/products/compliance/minimal_dashboard.jpg" alt="Managed VSOC 车联网安全运营仪表盘" />
                        </div>
                        <div class="case_content">
                            <span class="case_badge">🛡️ 真实主机厂标杆实绩</span>
                            <h4>某中国 OEM 欧盟数据平台合规整改与长效运营托管</h4>
                            <p>
                                协助国内头部车企打通欧盟数据平台合规整改，完成车端数据脱敏、云端审计轨迹与中欧跨境传输（SCC+TIA）建设。<br>
                                <strong>已打通整改与托管闭环，Managed VSOC 7×24 小时护航出海车辆合规与安全运转！</strong>
                            </p>
                            <div class="case_quick_stats">
                                <div class="stat_box">
                                    <div class="num">100%</div>
                                    <div class="label">整改托管闭环</div>
                                </div>
                                <div class="stat_box">
                                    <div class="num">7×24h</div>
                                    <div class="label">VSOC 安全运营</div>
                                </div>
                                <div class="stat_box">
                                    <div class="num">0 违规</div>
                                    <div class="label">监管处罚记录</div>
                                </div>
                            </div>
