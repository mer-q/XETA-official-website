---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProductsSection from '../../components/ProductsSection.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import AboutSection from '../../components/AboutSection.astro';
import ContactSection from '../../components/ContactSection.astro';
---

<Layout 
  title="Xetabyte - Make Mobility Space Smarter" 
  description="Xetabyte - Make Mobility Space Smarter. Building Next-Gen Automotive Intelligence Ecosystem."
  lang="en"
  currentPath="/en/"
>
  <div class="home_page">
    <Hero lang="en" />
    <ProductsSection lang="en" />
    <ServicesSection lang="en" />
    <AboutSection lang="en" />
    <ContactSection lang="en" />
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Core Products Slider Interaction
    const productItems = document.querySelectorAll('.main_product_slider_item');
    const productNavs = document.querySelectorAll('.main_product_slider_navigation li');
    
    productItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        productItems.forEach(el => el.classList.remove('active'));
        productNavs.forEach(el => el.classList.remove('active'));
        item.classList.add('active');
        if (productNavs[index]) productNavs[index].classList.add('active');
      });
    });

    productNavs.forEach((nav, index) => {
      nav.addEventListener('click', () => {
        productItems.forEach(el => el.classList.remove('active'));
        productNavs.forEach(el => el.classList.remove('active'));
        if (productItems[index]) productItems[index].classList.add('active');
        nav.classList.add('active');
      });
    });

    // 2. Services Accordion Interaction
    const serviceItems = document.querySelectorAll('.service_box_item');
    serviceItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        serviceItems.forEach(el => el.classList.remove('active'));
        item.classList.add('active');
      });
    });
  });
</script>
