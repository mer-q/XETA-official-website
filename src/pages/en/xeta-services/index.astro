---
import '../../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XETA Services - Xetabyte</title>
    <meta name="description" content="XETA SERVICES - Empowering Global OEMs in International Market Expansion.">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="wp-singular post-template-default single single-post postid-157 single-format-standard wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- Header Navigation -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/en/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="Xetabyte" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu_en" class="menu">
                    <li class="menu-item"><a href="/en/">HOME</a></li>
                    <li class="menu-item"><a href="/en/xeta-products/">PRODUCTS</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/en/xeta-services/" aria-current="page">SERVICES</a>
                        <ul class="sub-menu">
                            <li><a href="/en/xeta-services/#service01">XETA&nbsp;Global&nbsp;Auto<br>Service&nbsp;Platform</a></li>
                            <li><a href="/en/xeta-services/#service02">Development &amp; Platform Operations</a></li>
                            <li><a href="/en/xeta-services/#service03">Technical&nbsp;Certification &amp; Compliance</a></li>
                            <li><a href="/en/xeta-services/#service04">Market &amp; Product Support</a></li>
                        </ul>
                    </li>
                    <li class="menu-item"><a href="/en/about-us/">ABOUT US</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/数智化服务/">简体中文</option>
                        <option value="/en/xeta-services/" selected>English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page">
        <!-- Banner -->
        <div class="inner_page_intro_box" style="background-image: url('/uploads/2025/09/数智化服务banner-scaled.jpg');">
            <div class="inner_page_intro_box_inner">
                <h1 class="inner_page_intro_box_title wow fadeInUp">XETA SERVICES</h1>
                <span class="inner_page_intro_box_subtitle wow fadeInUp">Empowering Global OEMs in International Market Expansion.</span>
            </div>
        </div>

        <!-- Service 01 -->
        <div id="service01" class="service_content_box">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">XETA GLOBAL AUTO<br>SERVICE PLATFORM</h2>
                <p>
                    <span class="service_content_box_subtitle wow fadeInUp">Full-Process Global Expansion Support for OEMs.</span><br>
                    <img class="service_content_box_inner_banner_01 wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/platform_service/service_inner_banner_en.png" alt="Service Platform" />
                </p>
            </div>
        </div>

        <!-- Service 02 -->
        <div id="service02" class="service_content_box service_content_box_platform">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">DEVELOPMENT &amp; PLATFORM OPERATIONS</h2>
                <div><span class="service_content_box_subtitle wow fadeInUp">DevOps for Telematics, Data Platforms, and AI Applications.</span></div>
                <div class="service_content_box_platform_item_box">
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>Overseas Telematics &amp;<br>Data Center Operations</h3>
                        <p><span>Planning and Establishment of Local Data Centers<br>and Telematics Systems; Ensuring seamless data<br>access, transmission, and localization.</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>Test Vehicle Data Platform<br>Development (MDR Project)</h3>
                        <p><span>Platform Development &amp; Integration: Covering<br>data collection, transmission, storage,<br>visualization, and enterprise user access.</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>ADAS Road Test Data: Collection,<br>De-identification, and Transmission</h3>
                        <p><span>Professional data collection solutions for ADAS<br>systems, ensuring privacy processing and remote<br>transmission to support algorithm training and<br>evaluation.</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>Intelligent Service Platform<br>Deployment &amp; Continuous<br>Operations (DevOps)</h3>
                        <p><span>Platform Deployment and Ongoing Support for AI<br>Concierge, Cockpit Systems, and other key modules.</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 03 -->
        <div id="service03" class="service_content_box service_content_box_tech">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">TECHNICAL CERTIFICATION &amp; COMPLIANCE SERVICES</h2>
                <p><span class="service_content_box_subtitle wow fadeInUp">Global Regulatory Compliance and Risk Mitigation for OEMs.</span></p>
                <div class="service_content_box_tech_slider_box">
                    <div class="service_content_box_tech_slider_box_inner" id="techSliderImages">
                        <img class="active" src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_01.png" alt="" />
                        <img src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_02.png" alt="" />
                        <img src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_03.png" alt="" />
                    </div>
                    <div class="service_content_box_tech_slider_box_navigation" id="techSliderNav">
                        <div class="service_content_box_tech_slider_box_navigation_item active">
                            <h3>EU GDPR Compliance<br>&amp; System Hardening</h3>
                            <p><span>Solutions for data processing procedure rectification and system optimization, ensuring compliant data collection, transmission, and storage per EU GDPR.</span></p>
                        </div>
                        <div class="service_content_box_tech_slider_box_navigation_item">
                            <h3>ISO 27001 Information<br>Security Management System<br>(ISMS) Certification</h3>
                            <p><span>Establishing and certifying a complete ISMS to standardize enterprise information security management.</span></p>
                        </div>
                        <div class="service_content_box_tech_slider_box_navigation_item">
                            <h3>Automotive Cybersecurity<br>Compliance (UNECE WP.29)</h3>
                            <p><span>Certification services adhering to UNECE WP.29 regulations, ensuring robust vehicle cybersecurity protection capabilities.</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 04 -->
        <div id="service04" class="service_content_box service_content_box_support">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">MARKET &amp; PRODUCT SUPPORT SERVICES</h2>
                <div><span class="service_content_box_subtitle wow fadeInUp">Data-Driven Support for Localization, Insights, and Ecosystem Growth.</span></div>
                <div class="service_content_box_support_item_box">
                    <div class="service_content_box_support_item_box_item wow fadeInUp">
                        <h3>Overseas User<br>Research &amp; Testing</h3>
                        <p><span>Organizing real-user testing and qualitative interviews to facilitate rapid product adaptation and optimization in local markets.</span></p>
                    </div>
                    <div class="service_content_box_support_item_box_right wow fadeInUp">
                        <div class="service_content_box_support_item_box_item">
                            <h3>Intelligent Product Pre- and<br>Post-Sales Support</h3>
                            <p><span>Consulting on market access analysis, sales channel strategy,<br>and brand localization across target regions.</span></p>
                        </div>
                        <div class="service_content_box_support_item_box_item">
                            <h3>Global Ecosystem &amp; Partnership<br>Expansion</h3>
                            <p><span>Connecting OEMs with international industry resources and technical standards organizations to build stable global cooperation and ecosystem influence.</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">CONTACT US</h4>
                    <p>Email: <a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">BUSINESS COOPERATION</h4>
                    <p>Email: <a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>FOLLOW XETA</h4>
                <div class="wechat_qrcode"></div>
                <p>Official WeChat</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">Copyright © 2025-2026 XETA Intelligence Technology (Shanghai) Co., Ltd. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }

            const navItems = document.querySelectorAll('#techSliderNav .service_content_box_tech_slider_box_navigation_item');
            const sliderImgs = document.querySelectorAll('#techSliderImages img');
            navItems.forEach((nav, index) => {
                nav.addEventListener('click', () => {
                    navItems.forEach(el => el.classList.remove('active'));
                    sliderImgs.forEach(el => el.classList.remove('active'));
                    nav.classList.add('active');
                    if (sliderImgs[index]) sliderImgs[index].classList.add('active');
                });
            });
        });
    </script>
</body>
</html>
