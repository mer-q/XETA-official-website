---
import '../../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI-Powered Cockpit Software Development Services - Xetabyte</title>
    <meta name="description" content="AI-Powered Cockpit Software Development Services by XETA Intelligence. Elite Team × AI Toolchain = Enterprise-Grade Output.">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">

    <style>
        /* PDF Export & Print Color Adjust */
        @media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            header.top-header {
                position: relative !important;
            }

            .product_hero_banner {
                background: linear-gradient(135deg, rgba(13, 19, 43, 0.96) 0%, rgba(26, 36, 71, 0.92) 100%) !important;
                color: #ffffff !important;
            }

            .featured_case_banner {
                background: #0f172a !important;
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.15) !important;
            }

            .featured_case_banner h3, .case_content p {
                color: #ffffff !important;
            }

            .case_quick_stats {
                background: rgba(0, 0, 0, 0.4) !important;
            }

            .stat_box .num {
                color: #00d084 !important;
            }
        }

        .product_hero_banner {
            width: 100%;
            min-height: 480px;
            background: linear-gradient(135deg, rgba(13, 19, 43, 0.96) 0%, rgba(26, 36, 71, 0.92) 100%), url('/images/products/ai_cockpit/sleek_hmi.jpg') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 70px;
            box-sizing: border-box;
        }

        .product_hero_inner {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            text-align: center;
            z-index: 2;
        }

        .product_hero_inner h1 {
            font-size: 48px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 18px;
            letter-spacing: 0.5px;
            line-height: 1.2;
        }

        .product_hero_inner p {
            font-size: 17.5px;
            color: rgba(255, 255, 255, 0.88);
            max-width: 860px;
            margin: 0 auto;
            line-height: 1.65;
            font-weight: 300;
        }

        .metrics_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1200px;
            margin: -45px auto 65px;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .metric_card {
            background: #ffffff;
            border-radius: 14px;
            padding: 32px 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
            border-top: 4px solid #2a55e5;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .metric_card:hover { transform: translateY(-6px); }

        .metric_value {
            font-size: 46px;
            font-weight: 800;
            color: #2a55e5;
            line-height: 1;
            margin-bottom: 10px;
            font-family: 'Urbanist', sans-serif;
        }

        .metric_title {
            font-size: 19px;
            font-weight: 600;
            color: #111;
            margin-bottom: 6px;
        }

        .metric_desc {
            font-size: 13.5px;
            color: #666;
            line-height: 1.5;
        }

        .section_block {
            max-width: 1200px;
            margin: 0 auto 80px;
            padding: 0 20px;
        }

        .section_header {
            text-align: center;
            margin-bottom: 44px;
        }

        .section_header h2 {
            font-size: 36px;
            font-weight: 600;
            color: #111111;
            margin-bottom: 10px;
        }

        .section_header p {
            font-size: 15.5px;
            color: #666666;
        }

        .featured_case_banner {
            background: linear-gradient(135deg, #0d132b 0%, #172147 100%);
            border-radius: 18px;
            padding: 44px;
            color: #ffffff;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
            margin-bottom: 70px;
        }

        .case_flex {
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .case_thumb {
            flex: 1.1;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .case_thumb img {
            width: 100%;
            height: auto;
            display: block;
        }

        .case_content { flex: 1; }

        .case_badge {
            display: inline-block;
            background: rgba(0, 255, 254, 0.15);
            color: #00fffe;
            font-size: 13px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 14px;
            border: 1px solid rgba(0, 255, 254, 0.3);
        }

        .case_content h3 {
            font-size: 28px;
            color: #ffffff;
            margin-bottom: 14px;
            line-height: 1.35;
        }

        .case_content p {
            font-size: 15px;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.65;
            margin-bottom: 24px;
        }

        .case_quick_stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat_box { text-align: center; }
        .stat_box .num {
            font-size: 28px;
            font-weight: 700;
            color: #00fffe;
            font-family: 'Urbanist', sans-serif;
        }
        .stat_box .label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 2px;
        }

        .img_feature_flex {
            display: flex;
            align-items: center;
            gap: 44px;
            background: #ffffff;
            border-radius: 16px;
            padding: 36px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.05);
            border: 1px solid #eef2f6;
            margin-bottom: 70px;
        }

        .img_feature_thumb {
            flex: 1;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        .img_feature_thumb img {
            width: 100%;
            height: auto;
            display: block;
        }

        .img_feature_text { flex: 1; }

        .img_feature_text h3 {
            font-size: 26px;
            font-weight: 600;
            color: #111;
            margin-bottom: 14px;
            line-height: 1.35;
        }

        .img_feature_text p {
            font-size: 14.5px;
            color: #555;
            line-height: 1.7;
        }

        .pain_claim_grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .pain_box {
            background: #fff5f5;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #ff4d4f;
        }

        .claim_box {
            background: #f0f7ff;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #2a55e5;
        }

        .box_title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .pain_box .box_title { color: #cf1322; }
        .claim_box .box_title { color: #1d39c4; }

        .item_list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .item_list li {
            font-size: 14.5px;
            line-height: 1.65;
            margin-bottom: 12px;
            color: #333333;
            position: relative;
            padding-left: 22px;
        }

        .pain_box .item_list li::before {
            content: "✕";
            position: absolute;
            left: 0;
            color: #ff4d4f;
            font-weight: bold;
        }

        .claim_box .item_list li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #2a55e5;
            font-weight: bold;
        }

        .pipeline_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .pipeline_card {
            background: #ffffff;
            border-radius: 14px;
            padding: 28px 22px;
            border: 1px solid #e8e8e8;
            transition: all 0.3s ease;
        }

        .pipeline_card:hover {
            border-color: #2a55e5;
            box-shadow: 0 8px 25px rgba(42, 85, 229, 0.1);
        }

        .step_num {
            font-size: 32px;
            font-weight: 800;
            color: #2a55e5;
            opacity: 0.85;
            margin-bottom: 10px;
            font-family: 'Urbanist', sans-serif;
        }

        .pipeline_card h3 {
            font-size: 19px;
            font-weight: 600;
            color: #111;
            margin-bottom: 8px;
        }

        .pipeline_card p {
            font-size: 13.5px;
            color: #666;
            line-height: 1.6;
        }

        .compare_table_wrapper {
            overflow-x: auto;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid #eee;
        }

        .compare_table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .compare_table th, .compare_table td {
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
            font-size: 14.5px;
        }

        .compare_table th {
            background: #fafafa;
            font-weight: 600;
            color: #111;
        }

        .compare_table td.our_service {
            background: #f4f7ff;
            color: #2a55e5;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .product_hero_inner h1 { font-size: 30px; }
            .metrics_grid { grid-template-columns: 1fr; margin-top: 15px; }
            .case_flex { flex-direction: column; }
            .img_feature_flex { flex-direction: column; padding: 24px; }
            .pain_claim_grid { grid-template-columns: 1fr; }
            .pipeline_grid { grid-template-columns: 1fr; }
            .case_quick_stats { grid-template-columns: 1fr; }
            .featured_case_banner { padding: 24px; }
        }
    </style>
</head>
<body class="wp-singular page-template page-template-page-products page-template-page-products-php page wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- Header Navigation -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/en/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="Xetabyte" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu_en" class="menu">
                    <li class="menu-item"><a href="/en/">HOME</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/en/xeta-products/">PRODUCTS</a></li>
                    <li class="menu-item"><a href="/en/xeta-services/">SERVICES</a></li>
                    <li class="menu-item"><a href="/en/about-us/">ABOUT US</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/ai-cockpit/">简体中文</option>
                        <option value="/en/ai-cockpit/" selected>English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page" style="padding-top: 64px;">
        <!-- Hero Banner -->
        <section class="product_hero_banner">
            <div class="product_hero_inner">
                <h1>AI-Powered Cockpit Software Development Services</h1>
                <p>
                    Overcoming the software delivery "Impossible Triangle". Driven by deep automotive cockpit engineering expertise<br>
                    and proprietary AI toolchains, covering Requirement Analysis → HMI Design → Coding → Automated Testing → CI/CD Integration → Maintenance.
                </p>
            </div>
        </section>

        <!-- Metrics Bar -->
        <div class="metrics_grid">
            <div class="metric_card">
                <div class="metric_value">&gt;6×</div>
                <div class="metric_title">Delivery Efficiency Gain</div>
                <div class="metric_desc">1 person-month output equals traditional 6 person-months</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">90%↓</div>
                <div class="metric_title">Rework &amp; Defect Reduction</div>
                <div class="metric_desc">Structured requirements &amp; AI safeguards prevent defects early</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">20%↓</div>
                <div class="metric_title">Total Delivery Cost Savings</div>
                <div class="metric_desc">Lean high-density elite team amplified by AI tools</div>
            </div>
        </div>

        <!-- High Impact Real Track Record -->
        <section class="section_block">
            <div class="featured_case_banner">
                <div class="case_flex">
                    <div class="case_thumb">
                        <img src="/images/products/ai_cockpit/sleek_hmi.jpg" alt="PHEV Infotainment Overhaul Benchmark" />
                    </div>
                    <div class="case_content">
                        <span class="case_badge">🏆 Real Delivery Track Record</span>
                        <h3>PHEV Hybrid Infotainment Deep Overhaul</h3>
                        <p>
                            Based on original OEM source code baseline, performed deep overhaul and feature development for a PHEV model (Android 80+ pages, 90+ verified points).<br>
                            <strong>Result: 100% AI-generated code. Planned 4-week delivery completed 2 weeks ahead of schedule!</strong>
                        </p>
                        <div class="case_quick_stats">
                            <div class="stat_box">
                                <div class="num">1 vs 6</div>
                                <div class="label">Efficiency Ratio</div>
                            </div>
                            <div class="stat_box">
                                <div class="num">~30,000</div>
                                <div class="label">Lines Changed</div>
                            </div>
                            <div class="stat_box">
                                <div class="num">100%</div>
                                <div class="label">AI Code Gen</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Feature Block 2 -->
        <section class="section_block">
            <div class="img_feature_flex">
                <div class="img_feature_thumb">
                    <img src="/images/products/ai_cockpit/minimal_code.jpg" alt="Minimalist High-Tech Architecture" />
                </div>
                <div class="img_feature_text">
                    <h3>15+ Years Cockpit Depth<br>Full-Stack AI-Assisted HMI &amp; System Dev</h3>
                    <p>
                        For Android infotainment, digital clusters, and multi-screen interactive software, XETA provides end-to-end automation from UI/UX design to native code.
                    </p>
                    <p style="margin-top: 12px;">
                        Architects focus on core system logic, while repetitive UI pages, vehicle signal alignments, and component code are 100% generated by AI toolchains.
                    </p>
                </div>
            </div>
        </section>

        <!-- Pain Points vs Core Pillars -->
        <section class="section_block">
            <div class="section_header">
                <h2>Reshaping Automotive Cockpit Software Delivery</h2>
                <p>Cockpit software complexity is exploding while traditional headcount-scaling hits an efficiency ceiling</p>
            </div>

            <div class="pain_claim_grid">
                <div class="pain_box">
                    <div class="box_title">
                        <span>Real OEM Pain Points</span>
                    </div>
                    <ul class="item_list">
                        <li><strong>Headcount Bloat without Speed Gain</strong>: More headcount leads to higher communication entropy.</li>
                        <li><strong>Long Chain from Requirements to Code</strong>: Disconnect between spec and code causes high rework.</li>
                        <li><strong>Quality vs. Speed Trade-off</strong>: Rushing for SOP compromises code quality and stability.</li>
                        <li><strong>AI Tools Fall Short</strong>: Lacking engineering methodology, AI tools remain "toys".</li>
                        <li><strong>Scarce &amp; Costly Experts</strong>: Senior architects with deep cockpit experience are hard to find.</li>
                    </ul>
                </div>

                <div class="claim_box">
                    <div class="box_title">
                        <span>XETA's Core Pillars</span>
                    </div>
                    <ul class="item_list">
                        <li><strong>Elite Density</strong>: Senior architects &amp; full-stack engineers end-to-end.</li>
                        <li><strong>AI Amplifier</strong>: In-house AI toolchains liberate engineers from repetitive labor.</li>
                        <li><strong>Methodology Accumulation</strong>: Unified toolchains grow faster &amp; safer per project.</li>
                        <li><strong>Automated Pipeline Endpoint</strong>: Turning cockpit software dev into a measurable pipeline.</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 6-Stage Pipeline -->
        <section class="section_block">
            <div class="section_header">
                <h2>6-Stage End-to-End Delivery Pipeline</h2>
                <p>Full-spectrum AI safeguards ensuring high quality and on-time delivery</p>
            </div>

            <div class="pipeline_grid">
                <div class="pipeline_card">
                    <div class="step_num">01</div>
                    <h3>Requirement Extraction &amp; Decomposition</h3>
                    <p>Structured extraction of requirements, AI generation of user stories, acceptance criteria, and task decomposition.</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">02</div>
                    <h3>UI / UE Interactive Design</h3>
                    <p>HMI-compliant interactive design, AI-assisted design-to-code conversion, and multi-vehicle model adaptation.</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">03</div>
                    <h3>AI-Assisted Full-Stack Coding</h3>
                    <p>AI-assisted coding with reusable cockpit component libraries, guarded by architectural constraints.</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">04</div>
                    <h3>Automated Testing &amp; Verification</h3>
                    <p>AI-generated test cases and scripts covering functionality, performance, compatibility, and bug classification.</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">05</div>
                    <h3>Delivery &amp; CI/CD Integration</h3>
                    <p>Standardized deliverables seamlessly integrated into client CI/CD build pipelines with transparent progress.</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">06</div>
                    <h3>Maintenance &amp; Iteration</h3>
                    <p>Long-term maintenance and incremental feature development, reducing long-term maintenance costs.</p>
                </div>
            </div>
        </section>

        <!-- Comparison Table -->
        <section class="section_block">
            <div class="section_header">
                <h2>Why Choose XETA</h2>
                <p>Traditional Outsourcing / In-House Team vs. XETA AI End-to-End Service</p>
            </div>

            <div class="compare_table_wrapper">
                <table class="compare_table">
                    <thead>
                        <tr>
                            <th>Dimension</th>
                            <th>Traditional Outsourcing / In-House</th>
                            <th class="our_service">XETA AI End-to-End Service</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Efficiency Model</strong></td>
                            <td>Relying on headcount; entropy increases as team grows</td>
                            <td class="our_service">Elite density + AI amplification multiplies output</td>
                        </tr>
                        <tr>
                            <td><strong>Efficiency Curve</strong></td>
                            <td>Hard to reuse across projects; starts from scratch each time</td>
                            <td class="our_service">Toolchain &amp; methodology accumulate to grow faster</td>
                        </tr>
                        <tr>
                            <td><strong>Quality Assurance</strong></td>
                            <td>Dependent on individual experience; high variance</td>
                            <td class="our_service">Engineering constraints + AI safeguards ensure stability</td>
                        </tr>
                        <tr>
                            <td><strong>Requirement Alignment</strong></td>
                            <td>Spec disconnects from implementation; high rework rate</td>
                            <td class="our_service">Structured specs end-to-end; 90% rework reduction</td>
                        </tr>
                        <tr>
                            <td><strong>Domain Know-How</strong></td>
                            <td>Generic software developers lacking cockpit depth</td>
                            <td class="our_service">15+ years cockpit depth with mature component libraries</td>
                        </tr>
                        <tr>
                            <td><strong>Ultimate Goal</strong></td>
                            <td>Delivering a single static project</td>
                            <td class="our_service">Transforming into a customer-owned automated delivery pipeline</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">CONTACT US</h4>
                    <p>Email: <a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">BUSINESS COOPERATION</h4>
                    <p>Email: <a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>FOLLOW XETA</h4>
                <div class="wechat_qrcode"></div>
                <p>Official WeChat</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">Copyright © 2025-2026 XETA Intelligence Technology (Shanghai) Co., Ltd. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }
        });
    </script>
</body>
</html>
