---
import '../../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XETA PRODUCTS - Xetabyte</title>
    <meta name="description" content="XETA PRODUCTS - Building the Global Automotive Smart Ecosystem.">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="wp-singular page-template page-template-page-products page-template-page-products-php page wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- Header Navigation -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/en/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="Xetabyte" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu_en" class="menu">
                    <li class="menu-item"><a href="/en/">HOME</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/en/xeta-products/" aria-current="page">PRODUCTS</a></li>
                    <li class="menu-item"><a href="/en/xeta-services/">SERVICES</a></li>
                    <li class="menu-item"><a href="/en/about-us/">ABOUT US</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/核心产品/">简体中文</option>
                        <option value="/en/xeta-products/" selected>English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page">
        <!-- Banner -->
        <div class="inner_page_intro_box" style="background-image: url('/uploads/2025/09/核心产品banner-scaled.jpg');">
            <div class="inner_page_intro_box_inner">
                <h1 class="inner_page_intro_box_title wow fadeInUp">XETA PRODUCTS</h1>
                <span class="inner_page_intro_box_subtitle wow fadeInUp">Building the Global Automotive Smart Ecosystem</span>
            </div>
        </div>

        <div class="inner_page_content">
            <!-- Product 01: XETA AUTO AI AGENT -->
            <div id="product01" class="main_product_slider_box">
                <div class="main_product_slider_box_title wow fadeInUp">
                    <h2>XETA AUTO<br>AI AGENT</h2>
                    <p>LLM-Powered Interaction for a Personalized Cabin Experience.</p>
                </div>
                <div class="main_product_slider_box_inner">
                    <div class="main_product_slider_box_inner_item active"></div>
                    <div class="main_product_slider_box_inner_item"></div>
                </div>
                <ul class="main_product_slider_box_navigation">
                    <li class="active"></li>
                    <li></li>
                </ul>
            </div>

            <div class="main_product_slider_box_content">
                <div class="main_product_slider_box_content_inner">
                    <p class="wow fadeInUp">
                        This in-vehicle intelligent interaction system, built on an LLM,<br>
                        Features: Natural Language Understanding (NLU), contextual memory, proactive recommendation, and voice control.<br>
                        Delivering a safer, more efficient, and personalized intelligent cabin experience.<br>
                        Seamless integration with navigation, entertainment, climate control, and vehicle status systems.<br>
                        XETA's core user gateway for next-generation intelligent vehicles.
                    </p>
                    <div class="main_product_slider_box_content_inner_item_box">
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>Intelligent Experience</h3>
                            <p>The core of user-perceivable intelligence.</p>
                        </div>
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>Customization</h3>
                            <p>Support for custom brand identity and voice profiles.</p>
                        </div>
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>System Adaptability</h3>
                            <p>Compatible with all mainstream operating systems<br>and hardware platforms.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product 02: XETA Auto AI Platform -->
            <div id="product02" class="main_product_content_box">
                <div class="main_product_content_box_inner">
                    <h2 class="wow fadeInUp">XETA Auto<br>AI Platform</h2>
                    <div>
                        <span class="wow fadeInUp">Unifying Data, Models, and Smart Applications into a Vehicle-Centric Platform.</span><br>
                        <img class="main_product_content_box_inner_img wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/main_product/main_product_content_img_en.png" alt="XETA Auto AI Platform" />
                    </div>
                    <p class="wow fadeInUp">
                        Focusing on three core intelligent vehicle layers: Unifying Data, Model, and Application Middleware.<br>
                        Key Modules for OEMs: Intelligent Cockpit Systems, AI Concierge Integration, Model Access, and Execution Environments.<br>
                        Supporting cross-platform deployment and customized delivery,<br>
                        enabling sustainable and evolvable smart system infrastructure.
                    </p>
                    <div class="main_product_content_box_inner_feature">
                        <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                            <h3>Data Integration Framework</h3>
                            <div><span>Unifying data, models, and smart applications for<br>a vehicle-centric system integration framework.</span></div>
                        </div>
                        <div class="main_product_content_box_inner_feature_right">
                            <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                                <h3>Multi-Model Deployment</h3>
                                <div><span>Supports multi-model deployment, scheduling, and updating to meet<br>LLMs' vehicle-side operation and management needs.</span></div>
                            </div>
                            <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                                <h3>Rapid Integration Environment</h3>
                                <div><span>Rapid integration environment for cabin and service applications, streamlining the<br>launch process for modules like voice assistants and HMI systems.</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">CONTACT US</h4>
                    <p>Email: <a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">BUSINESS COOPERATION</h4>
                    <p>Email: <a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>FOLLOW XETA</h4>
                <div class="wechat_qrcode"></div>
                <p>Official WeChat</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">Copyright © 2025-2026 XETA Intelligence Technology (Shanghai) Co., Ltd. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }
        });
    </script>
</body>
</html>
