---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 赋能智能座舱软件开发服务 - 字特智能</title>
    <meta name="description" content="字特智能 - AI 赋能的智能座舱软件开发服务。突破软件交付“不可能三角”。">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">

    <style>
        .product_hero_banner {
            width: 100%;
            min-height: 480px;
            background: linear-gradient(135deg, rgba(13, 19, 43, 0.96) 0%, rgba(26, 36, 71, 0.92) 100%), url('/images/products/ai_cockpit/sleek_hmi.jpg') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 70px;
            box-sizing: border-box;
        }

        .product_hero_inner {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            text-align: center;
            z-index: 2;
        }

        .product_hero_inner h1 {
            font-size: 48px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 20px;
            letter-spacing: 1px;
            line-height: 1.25;
        }

        .product_hero_inner p {
            font-size: 17.5px;
            color: rgba(255, 255, 255, 0.88);
            max-width: 860px;
            margin: 0 auto;
            line-height: 1.65;
            font-weight: 300;
        }

        /* 核心指标 Pillar Bar */
        .metrics_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1200px;
            margin: -45px auto 65px;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .metric_card {
            background: #ffffff;
            border-radius: 14px;
            padding: 32px 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
            border-top: 4px solid #2a55e5;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .metric_card:hover { transform: translateY(-6px); }

        .metric_value {
            font-size: 46px;
            font-weight: 800;
            color: #2a55e5;
            line-height: 1;
            margin-bottom: 10px;
            font-family: 'Urbanist', sans-serif;
        }

        .metric_title {
            font-size: 19px;
            font-weight: 600;
            color: #111;
            margin-bottom: 6px;
        }

        .metric_desc {
            font-size: 13.5px;
            color: #666;
            line-height: 1.5;
        }

        .section_block {
            max-width: 1200px;
            margin: 0 auto 80px;
            padding: 0 20px;
        }

        .section_header {
            text-align: center;
            margin-bottom: 44px;
        }

        .section_header h2 {
            font-size: 36px;
            font-weight: 600;
            color: #111111;
            margin-bottom: 10px;
        }

        .section_header p {
            font-size: 15.5px;
            color: #666666;
        }

        /* 重点提前 1: 真实案例实绩 */
        .featured_case_banner {
            background: linear-gradient(135deg, #0d132b 0%, #172147 100%);
            border-radius: 18px;
            padding: 44px;
            color: #ffffff;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
            margin-bottom: 70px;
        }

        .case_flex {
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .case_thumb {
            flex: 1.1;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .case_thumb img {
            width: 100%;
            height: auto;
            display: block;
        }

        .case_content { flex: 1; }

        .case_badge {
            display: inline-block;
            background: rgba(0, 255, 254, 0.15);
            color: #00fffe;
            font-size: 13px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 14px;
            border: 1px solid rgba(0, 255, 254, 0.3);
        }

        .case_content h3 {
            font-size: 28px;
            color: #ffffff;
            margin-bottom: 14px;
            line-height: 1.35;
        }

        .case_content p {
            font-size: 15px;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.65;
            margin-bottom: 24px;
        }

        .case_quick_stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat_box { text-align: center; }
        .stat_box .num {
            font-size: 28px;
            font-weight: 700;
            color: #00fffe;
            font-family: 'Urbanist', sans-serif;
        }
        .stat_box .label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 2px;
        }

        .img_feature_flex {
            display: flex;
            align-items: center;
            gap: 44px;
            background: #ffffff;
            border-radius: 16px;
            padding: 36px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.05);
            border: 1px solid #eef2f6;
            margin-bottom: 70px;
        }

        .img_feature_thumb {
            flex: 1;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        .img_feature_thumb img {
            width: 100%;
            height: auto;
            display: block;
        }

        .img_feature_text { flex: 1; }

        .img_feature_text h3 {
            font-size: 26px;
            font-weight: 600;
            color: #111;
            margin-bottom: 14px;
            line-height: 1.35;
        }

        .img_feature_text p {
            font-size: 14.5px;
            color: #555;
            line-height: 1.7;
        }

        .pain_claim_grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .pain_box {
            background: #fff5f5;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #ff4d4f;
        }

        .claim_box {
            background: #f0f7ff;
            border-radius: 14px;
            padding: 36px;
            border-left: 5px solid #2a55e5;
        }

        .box_title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .pain_box .box_title { color: #cf1322; }
        .claim_box .box_title { color: #1d39c4; }

        .item_list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .item_list li {
            font-size: 14.5px;
            line-height: 1.65;
            margin-bottom: 12px;
            color: #333333;
            position: relative;
            padding-left: 22px;
        }

        .pain_box .item_list li::before {
            content: "✕";
            position: absolute;
            left: 0;
            color: #ff4d4f;
            font-weight: bold;
        }

        .claim_box .item_list li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #2a55e5;
            font-weight: bold;
        }

        .pipeline_grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .pipeline_card {
            background: #ffffff;
            border-radius: 14px;
            padding: 28px 22px;
            border: 1px solid #e8e8e8;
            transition: all 0.3s ease;
        }

        .pipeline_card:hover {
            border-color: #2a55e5;
            box-shadow: 0 8px 25px rgba(42, 85, 229, 0.1);
        }

        .step_num {
            font-size: 32px;
            font-weight: 800;
            color: #2a55e5;
            opacity: 0.85;
            margin-bottom: 10px;
            font-family: 'Urbanist', sans-serif;
        }

        .pipeline_card h3 {
            font-size: 19px;
            font-weight: 600;
            color: #111;
            margin-bottom: 8px;
        }

        .pipeline_card p {
            font-size: 13.5px;
            color: #666;
            line-height: 1.6;
        }

        .compare_table_wrapper {
            overflow-x: auto;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid #eee;
        }

        .compare_table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .compare_table th, .compare_table td {
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
            font-size: 14.5px;
        }

        .compare_table th {
            background: #fafafa;
            font-weight: 600;
            color: #111;
        }

        .compare_table td.our_service {
            background: #f4f7ff;
            color: #2a55e5;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .product_hero_inner h1 { font-size: 30px; }
            .metrics_grid { grid-template-columns: 1fr; margin-top: 15px; }
            .case_flex { flex-direction: column; }
            .img_feature_flex { flex-direction: column; padding: 24px; }
            .pain_claim_grid { grid-template-columns: 1fr; }
            .pipeline_grid { grid-template-columns: 1fr; }
            .case_quick_stats { grid-template-columns: 1fr; }
            .featured_case_banner { padding: 24px; }
        }
    </style>
</head>
<body class="wp-singular page-template page-template-page-products page-template-page-products-php page wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部 Header 导航栏 -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li class="menu-item"><a href="/">首页</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/核心产品/">核心产品</a></li>
                    <li class="menu-item"><a href="/数智化服务/">数智化服务</a></li>
                    <li class="menu-item"><a href="/资讯中心/">资讯中心</a></li>
                    <li class="menu-item"><a href="/关于我们/">关于我们</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/ai-cockpit/" selected>简体中文</option>
                        <option value="/en/ai-cockpit/">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page" style="padding-top: 64px;">
        <!-- Hero 头部 Banner -->
        <section class="product_hero_banner">
            <div class="product_hero_inner">
                <h1>AI 赋能的智能座舱软件开发服务</h1>
                <p>
                    打破软件交付“不可能三角”。基于深厚的汽车座舱工程经验与自研全流程 AI 工具链，<br>
                    覆盖「需求分析 → HMI设计 → 编码开发 → 自动化测试 → CI/CD集成 → 长期维护」全链路交付。
                </p>
            </div>
        </section>

        <!-- 3 大核心量化指标 Pillar Bar -->
        <div class="metrics_grid">
            <div class="metric_card">
                <div class="metric_value">&gt;6×</div>
                <div class="metric_title">交付效率提升</div>
                <div class="metric_desc">打破传统靠堆人的模式，实测 1 人月完成传统 6 人月交付量</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">90%↓</div>
                <div class="metric_title">返工与缺陷减少</div>
                <div class="metric_desc">需求结构化提取与 AI 工程化守护，将质量问题前置解决</div>
            </div>
            <div class="metric_card">
                <div class="metric_value">20%↓</div>
                <div class="metric_title">综合成本降低</div>
                <div class="metric_desc">以高精英密度团队叠加 AI 放大器，显著节省整体开发开支</div>
            </div>
        </div>

        <!-- 真实项目落地实绩 -->
        <section class="section_block">
            <div class="featured_case_banner">
                <div class="case_flex">
                    <div class="case_thumb">
                        <img src="/images/products/ai_cockpit/sleek_hmi.jpg" alt="PHEV 混动智能车机改版实测图示" />
                    </div>
                    <div class="case_content">
                        <span class="case_badge">🏆 真实落地案例实绩</span>
                        <h3>某自主品牌 PHEV 混动车机深度改版</h3>
                        <p>
                            基于厂商完整源码基线，对一款插电混动车型座舱软件深度改版（Android 80+ 页面、90+ 功能点真机验证）。<br>
                            <strong>结果：代码 100% 由 AI 辅助生成，原计划 4 周开发提前 2 周圆满交付！</strong>
                        </p>
                        <div class="case_quick_stats">
                            <div class="stat_box">
                                <div class="num">1 vs 6</div>
                                <div class="label">人效比提升</div>
                            </div>
                            <div class="stat_box">
                                <div class="num">~3万行</div>
                                <div class="label">代码变更</div>
                            </div>
                            <div class="stat_box">
                                <div class="num">100%</div>
                                <div class="label">AI 辅助生成</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 架构能力 -->
        <section class="section_block">
            <div class="img_feature_flex">
                <div class="img_feature_thumb">
                    <img src="/images/products/ai_cockpit/minimal_code.jpg" alt="极简高科技架构示意图" />
                </div>
                <div class="img_feature_text">
                    <h3>深耕汽车座舱 15年+<br>全栈 AI 辅助 HMI 与系统开发</h3>
                    <p>
                        针对 Android 车机、仪表盘与多屏互动软件，字特智能打造了贯穿车载 UI/UX 设计稿到原生代码转化的自动化工具链。
                    </p>
                    <p style="margin-top: 12px;">
                        架构工程师只需关注核心系统业务逻辑与架构约束，重复性 UI 页面、车辆信号对齐、组件生成与兼容性代码由 AI 工具链精准生成。
                    </p>
                </div>
            </div>
        </section>

        <!-- 痛点 vs 核心主张 -->
        <section class="section_block">
            <div class="section_header">
                <h2>重塑汽车座舱软件交付模式</h2>
                <p>座舱功能指数级剧增，传统“堆人”开发模式已触及效率天花板</p>
            </div>

            <div class="pain_claim_grid">
                <div class="pain_box">
                    <div class="box_title">
                        <span>客户面临的真实痛点</span>
                    </div>
                    <ul class="item_list">
                        <li><strong>人力膨胀，效率不升</strong>：项目越多堆人越多，沟通与管理熵增反而拖慢节奏。</li>
                        <li><strong>需求到代码链路长</strong>：需求口口相传、文档与实现脱节，后期返工率高。</li>
                        <li><strong>质量与速度难兼得</strong>：赶节点往往牺牲质量，保质量又难以赶上车型 SOP。</li>
                        <li><strong>AI 工具难以落地</strong>：缺乏工程化方法论与落地约束，AI 沦为娱乐“玩具”。</li>
                        <li><strong>资深人才稀缺昂贵</strong>：真正懂座舱架构、懂 HMI 交互的高级工程师一将难求。</li>
                    </ul>
                </div>

                <div class="claim_box">
                    <div class="box_title">
                        <span>字特智能的核心主张</span>
                    </div>
                    <ul class="item_list">
                        <li><strong>精英密度</strong>：资深架构师与全栈工程师，独立打通需求到交付全链路。</li>
                        <li><strong>AI 放大器</strong>：自研 AI 工具链贯穿全流程，将工程师从重复劳动中解放。</li>
                        <li><strong>方法论沉淀</strong>：每个项目持续打磨同一套工具与流程，越合作越快越稳。</li>
                        <li><strong>终局自动化流水线</strong>：将座舱软件开发推进为可度量、可复用的流水线。</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 6 阶段全流程端到端覆盖 -->
        <section class="section_block">
            <div class="section_header">
                <h2>端到端 6 阶段服务流程</h2>
                <p>全链条 AI 工具守护，确保软件研发高质量按期交付</p>
            </div>

            <div class="pipeline_grid">
                <div class="pipeline_card">
                    <div class="step_num">01</div>
                    <h3>需求分析与拆解</h3>
                    <p>结构化抽取需求，AI 自动生成条目/用户故事/验收标准，智能拆解任务与工作量估算。</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">02</div>
                    <h3>UI / UE 交互设计</h3>
                    <p>基于 HMI 规范的交互设计，AI 辅助设计稿到前端代码自动化转化，支持多车型快速适配。</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">03</div>
                    <h3>AI 辅助编码开发</h3>
                    <p>AI 辅助全栈编码，沉淀可复用座舱组件库，代码规范与系统架构约束自动守护。</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">04</div>
                    <h3>自动化测试验证</h3>
                    <p>AI 自动生成测试用例与测试脚本，全面覆盖功能、性能与兼容性，实现缺陷自动归类。</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">05</div>
                    <h3>交付与 CI/CD 集成</h3>
                    <p>标准化交付物，无缝对接客户 CI/CD 编译流水线与版本管理，整体进度透明可控。</p>
                </div>
                <div class="pipeline_card">
                    <div class="step_num">06</div>
                    <h3>版本维护与迭代</h3>
                    <p>长期维护与功能增量开发，知识库与工具持续沉淀，后续维护成本随时间递减。</p>
                </div>
            </div>
        </section>

        <!-- 对比表格 Matrix -->
        <section class="section_block">
            <div class="section_header">
                <h2>为什么选择我们</h2>
                <p>传统外包/自建团队 vs 字特 AI 端到端服务</p>
            </div>

            <div class="compare_table_wrapper">
                <table class="compare_table">
                    <thead>
                        <tr>
                            <th>对比维度</th>
                            <th>传统外包 / 自建团队</th>
                            <th class="our_service">字特 AI 端到端服务</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>人效模型</strong></td>
                            <td>靠堆人，人员增加导致沟通熵增、边际效率递减</td>
                            <td class="our_service">精英密度 + AI 放大，个人产能实现数倍提升</td>
                        </tr>
                        <tr>
                            <td><strong>效率曲线</strong></td>
                            <td>项目间经验难以复用，每次新项目从零开始</td>
                            <td class="our_service">工具与方法论持续沉淀，越合作越快越稳</td>
                        </tr>
                        <tr>
                            <td><strong>质量保障</strong></td>
                            <td>依赖个人经验与情绪状态，质量波动较大</td>
                            <td class="our_service">工程化约束 + AI 规范守护，质量基线高度稳定</td>
                        </tr>
                        <tr>
                            <td><strong>需求一致性</strong></td>
                            <td>需求口口相传，文档与代码实现易脱节</td>
                            <td class="our_service">需求结构化贯穿全链路，返工率降低 90%</td>
                        </tr>
                        <tr>
                            <td><strong>领域 Know-how</strong></td>
                            <td>通用软件开发人员，缺乏座舱底层积累</td>
                            <td class="our_service">深耕汽车座舱 15年+，具备成熟组件与设计体系</td>
                        </tr>
                        <tr>
                            <td><strong>终局目标</strong></td>
                            <td>仅仅完成单个项目交付</td>
