---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>字特智能</title>
    <meta name="description" content="字特智能 - 让出行空间更智能。打造国际汽车智能化生态，共创全球智能汽车时代。">
    
    <!-- 站点 Favicon -->
    <link rel="icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <!-- 引入原版 animate.css 与 Swiper 样式 -->
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="home blog wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部导航栏 -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home" aria-current="page">
                <img width="264" height="64" src="/wp-content/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <!-- 手机版菜单按钮 -->
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li id="menu-item-282" class="menu-item menu-item-type-custom menu-item-object-custom current-menu-item current_page_item menu-item-home menu-item-282">
                        <a href="/" aria-current="page">首页</a>
                    </li>
                    <li id="menu-item-231" class="menu-item menu-item-type-post_type menu-item-object-post menu-item-231">
                        <a href="/核心产品/">核心产品</a>
                    </li>
                    <li id="menu-item-232" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-232">
                        <a href="/数智化服务/">数智化服务</a>
                        <ul class="sub-menu">
                            <li id="menu-item-233" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-233"><a href="/数智化服务/#service01">XETA 国际汽车服务平台</a></li>
                            <li id="menu-item-234" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-234"><a href="/数智化服务/#service02">开发与平台运维</a></li>
                            <li id="menu-item-235" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-235"><a href="/数智化服务/#service03">技术认证与合规服务</a></li>
                            <li id="menu-item-236" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-236"><a href="/数智化服务/#service04">市场与产品服务支持</a></li>
                        </ul>
                    </li>
                    <li id="menu-item-238" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-238">
                        <a href="/资讯中心/">资讯中心</a>
                    </li>
                    <li id="menu-item-239" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-239">
                        <a href="/关于我们/">关于我们</a>
                    </li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/" lang="zh-CN" selected>简体中文</option>
                        <option value="/en/" lang="en-US">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <!-- 页面主要内容 -->
    <div class="home_page">
        <!-- Banner 视频模块 -->
        <div class="home_page_banner">
            <div class="home_page_banner_mask"></div>
            <video class="wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/top_movie.mp4" autoplay muted loop playsinline poster="/wp-content/themes/xetabyte_ver2/images/top_movie.jpg"></video>
            <div class="home_page_banner_content wow fadeInUp home_page_banner_content_text">
                <h1>让出行空间更智能</h1>
                <span>Make Mobility Space Smarter</span>
            </div>
        </div>

        <!-- 核心产品 Line 1 -->
        <div id="line1" class="home_page_part">
            <h1 class="part_title wow fadeInUp">核心产品</h1>
            <span class="part_title_sub wow fadeInUp">打造国际汽车智能化生态</span>
            <div class="main_product_slider wow fadeInUp">
                <div class="main_product_slider_box">
                    <div class="main_product_slider_item active">
                        <img src="/wp-content/uploads/2025/10/main_product_01.jpg" alt="AI 汽车智能管家 XETA Auto AI Agent" />
                        <div class="main_product_slider_item_inner">
                            <div class="main_product_slider_item_inner_intro">
                                <h2>AI 汽车智能管家 XETA Auto AI Agent</h2>
                                <span>基于大语言模型的智能交互助手，打造个性化车载交互体验</span>
                            </div>
                            <a class="main_product_slider_item_inner_read_more" href="#line1">了解更多</a>
                        </div>
                    </div>
                    <div class="main_product_slider_item">
                        <img src="/wp-content/uploads/2025/08/main_product_02.png" alt="汽车数智化平台 XETA Auto AI Platform" />
                        <div class="main_product_slider_item_inner">
                            <div class="main_product_slider_item_inner_intro">
                                <h2>汽车数智化平台 XETA Auto AI Platform</h2>
                                <span>联通数据、模型与智能应用，构建面向整车的智能系统平台</span>
                            </div>
                            <a class="main_product_slider_item_inner_read_more" href="#line1">了解更多</a>
                        </div>
                    </div>
                </div>
                <ul class="main_product_slider_navigation">
                    <li class="active"></li>
                    <li></li>
                </ul>
            </div>
        </div>

        <!-- 数智化服务 Line 2 -->
        <div id="line2" class="home_page_part">
            <h1 class="part_title wow fadeInUp">数智化服务</h1>
            <span class="part_title_sub wow fadeInUp">助力全球车企拓展国际市场</span>
            <ul class="service_box wow fadeInUp">
                <li class="service_box_item active">
                    <div class="service_box_item_intro">
                        <h2>XETA国际汽车平台</h2>
                        <span>提供出海全流程支持，助力车企拓展全球市场</span>
                    </div>
                    <a href="#line2" class="service_box_item_read_more">了解更多</a>
                </li>
                <li class="service_box_item">
                    <div class="service_box_item_intro">
                        <h2>技术认证与合规服务</h2>
                        <span>为主机厂提供全球法规适配、数据隐私合规<br>和信息安全等支持，降低出海风险</span>
                    </div>
                    <a href="#line2" class="service_box_item_read_more">了解更多</a>
                </li>
                <li class="service_box_item">
                    <div class="service_box_item_intro">
                        <h2>开发与平台运维</h2>
                        <span>提供车联网系统、数据平台及AI应用的开发<br>与维护服务，保障系统稳定运行</span>
                    </div>
                    <a href="#line2" class="service_box_item_read_more">了解更多</a>
                </li>
                <li class="service_box_item">
                    <div class="service_box_item_intro">
                        <h2>市场与产品服务支持</h2>
                        <span>结合用户与市场数据，为产品本地化、<br>用户洞察及生态拓展提供支撑</span>
                    </div>
                    <a href="#line2" class="service_box_item_read_more">了解更多</a>
                </li>
            </ul>
        </div>

        <!-- 关于我们 Line 3 -->
        <div id="line3" class="home_page_part">
            <div class="about_page_header">
                <div class="about_page_header_inner">
                    <h1 class="about_page_title wow fadeInUp">关于我们</h1>
                    <span class="about_page_subtitle wow fadeInUp">
                        字特智能是一家发源于德国、布局全球的汽车智能化科技公司。<br> 
                        公司聚焦新一代基于大模型的智能座舱和其应用生态，<br> 
                        通过打造国际化汽车数智化平台，服务全球汽车行业在智能化体系的落地和提升。<br> <br><br> 
                        核心团队来自中德美汽车产业+人工智能领域，<br> 
                        有开阔的国际视野，在汽车产业界、学术界有广泛的联系和深厚的背景。
                    </span>
                    <div class="about_page_header_inner_item_box">
                        <div class="about_page_header_inner_item_box_item wow fadeInUp">
                            <h3>使命</h3>
                            <span>打造国际汽车智能化生态，共创全球智能汽车时代</span>
                        </div>
                        <div class="about_page_header_inner_item_box_item wow fadeInUp">
                            <h3>愿景</h3>
                            <span>成为国际领先的汽车智能化供应商</span>
                        </div>
                        <div class="about_page_header_inner_item_box_item wow fadeInUp">
                            <h3>价值观</h3>
                            <span>客户至上，专业尽责，创新突破</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 联系我们 Line 4 -->
        <div id="line4" class="home_page_part_contact_us">
            <div class="home_page_part_contact_us_inner">
                <div class="home_page_part_contact_us_inner_box wow fadeInUp">
                    <div class="home_page_part_contact_us_inner_box_intro">
                        <h2>联系我们</h2>
                        <span>共创全球智能汽车时代</span>
                    </div>
                    <form class="home_page_part_contact_us_inner_box_form" id="contactForm">
                        <div class="form_title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
                                <path d="M19.8767 11.2932H4.65373C4.34173 11.2932 4.04414 11.1564 3.83294 10.9164L0.117794 6.65882C-0.146202 6.35642 0.0625948 5.87402 0.456189 5.87402H15.732C16.044 5.87402 16.3416 6.01082 16.548 6.24842L20.2295 10.4676C20.5079 10.7868 20.2871 11.2932 19.8719 11.2932H19.8767Z" fill="black"></path>
                                <path d="M30.3955 26.4814C30.7938 26.4814 31.1729 26.6642 31.4297 26.9785L47.8789 47.1357C48.1573 47.4789 47.9226 47.9999 47.4883 48H32.2432C31.9051 47.9999 31.5835 47.8442 31.3652 47.5781L18.835 32.2227C18.619 31.9563 18.2969 31.8027 17.9609 31.8027H8.35938C7.93218 31.8027 7.70651 31.2839 7.9873 30.9551L11.5127 26.8389C11.7071 26.611 11.9881 26.4814 12.2832 26.4814H30.3955ZM19.874 36.708C20.2892 36.708 20.5098 37.215 20.2314 37.5342L16.5498 41.7529C16.341 41.9905 16.0434 42.1279 15.7314 42.1279H0.456055C0.0625495 42.1279 -0.146535 41.6452 0.117188 41.3428L3.83496 37.085C4.0437 36.845 4.34143 36.7081 4.65332 36.708H19.874ZM47.4883 0C47.9226 0.000110457 48.1573 0.523494 47.8789 0.864258L31.4297 21.0215C31.1729 21.3358 30.7939 21.5186 30.3955 21.5186H12.2832C11.9881 21.5186 11.7071 21.389 11.5127 21.1611L7.9873 17.0449C7.70651 16.7161 7.93218 16.1973 8.35938 16.1973H17.9609C18.2969 16.1973 18.619 16.0437 18.835 15.7773L31.3652 0.422852C31.5835 0.15416 31.9049 0.000123347 32.2432 0H47.4883Z" fill="black"></path>
                            </svg>
                            <span>/WELCOME</span>
                        </div>
                        <div class="form_body">
                            <input class="form_attribute" type="text" name="contact_name" placeholder="您的姓名" required />
                            <input class="form_attribute" type="tel" name="contact_phone" placeholder="联系电话" required />
                            <input class="form_attribute" type="text" name="contact_company" placeholder="公司名称" />
                            <input class="form_attribute" type="email" name="contact_email" placeholder="常用邮箱" required />
                            
                            <input class="submit" type="submit" value="提交信息" />
                        </div>
                        <div class="submit_success" id="submitSuccess" style="display: none;">
                            <h3>提交成功</h3>
                            <span>感谢您的信任与支持，我们将尽快联系您</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部 Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">联系我们</h4>
                    <p>邮箱地址：<a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">商务合作</h4>
                    <p>邮箱地址：<a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>关注字特智能</h4>
                <div class="wechat_qrcode"></div>
                <p>官方微信</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">
                    Copyright © 2025-2026 字特智能科技（上海）有限公司 版权所有
                </p>
            </div>
        </div>
    </footer>

    <!-- 客户端交互逻辑 -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 0. 语言切换逻辑
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            // 1. 移动端菜单切换逻辑
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }

            // 2. 核心产品区域卡片手风琴 / 鼠标悬停切换逻辑
            const productItems = document.querySelectorAll('.main_product_slider_item');
            const productNavs = document.querySelectorAll('.main_product_slider_navigation li');
            
            productItems.forEach((item, index) => {
                item.addEventListener('mouseenter', () => {
                    productItems.forEach(el => el.classList.remove('active'));
                    productNavs.forEach(el => el.classList.remove('active'));
                    item.classList.add('active');
                    if (productNavs[index]) productNavs[index].classList.add('active');
                });
            });

            productNavs.forEach((nav, index) => {
                nav.addEventListener('click', () => {
                    productItems.forEach(el => el.classList.remove('active'));
                    productNavs.forEach(el => el.classList.remove('active'));
                    if (productItems[index]) productItems[index].classList.add('active');
                    nav.classList.add('active');
                });
            });

            // 3. 数智化服务区域手风琴交互
            const serviceItems = document.querySelectorAll('.service_box_item');
            serviceItems.forEach((item) => {
                item.addEventListener('mouseenter', () => {
                    serviceItems.forEach(el => el.classList.remove('active'));
                    item.classList.add('active');
                });
            });

            // 4. 表单提交交互演示
            const contactForm = document.getElementById('contactForm');
            const submitSuccess = document.getElementById('submitSuccess');
            if (contactForm && submitSuccess) {
                contactForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    contactForm.querySelector('.form_body').style.display = 'none';
                    submitSuccess.style.display = 'block';
                });
            }
        });
    </script>
</body>
</html>
