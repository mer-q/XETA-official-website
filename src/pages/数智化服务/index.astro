---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>数智化服务 - 字特智能</title>
    <meta name="description" content="字特智能 - 数智化服务，助力全球车企拓展国际市场。">
    
    <link rel="icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="wp-singular post-template-default single single-post postid-157 single-format-standard wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部导航栏 -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/wp-content/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li class="menu-item"><a href="/">首页</a></li>
                    <li class="menu-item"><a href="/核心产品/">核心产品</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/数智化服务/">数智化服务</a>
                        <ul class="sub-menu">
                            <li><a href="/数智化服务/#service01">XETA 国际汽车服务平台</a></li>
                            <li><a href="/数智化服务/#service02">开发与平台运维</a></li>
                            <li><a href="/数智化服务/#service03">技术认证与合规服务</a></li>
                            <li><a href="/数智化服务/#service04">市场与产品服务支持</a></li>
                        </ul>
                    </li>
                    <li class="menu-item"><a href="/资讯中心/">资讯中心</a></li>
                    <li class="menu-item"><a href="/关于我们/">关于我们</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/数智化服务/" selected>简体中文</option>
                        <option value="/en/xeta-services/">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page">
        <!-- Banner 头部 -->
        <div class="inner_page_intro_box" style="background-image: url('/wp-content/uploads/2025/09/数智化服务banner-scaled.jpg');">
            <div class="inner_page_intro_box_inner">
                <h1 class="inner_page_intro_box_title wow fadeInUp">数智化服务</h1>
                <span class="inner_page_intro_box_subtitle wow fadeInUp">助力全球车企拓展国际市场</span>
            </div>
        </div>

        <!-- Service 01 -->
        <div id="service01" class="service_content_box">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">XETA 国际汽车服务平台<br>XETA Global Auto Service Platform</h2>
                <p>
                    <span class="service_content_box_subtitle wow fadeInUp">提供出海全流程支持，助力车企拓展全球市场</span><br>
                    <img class="service_content_box_inner_banner_01 wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/platform_service/service_inner_banner.png" alt="服务平台" />
                </p>
            </div>
        </div>

        <!-- Service 02 -->
        <div id="service02" class="service_content_box service_content_box_platform">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">开发与平台运维</h2>
                <div><span class="service_content_box_subtitle wow fadeInUp">提供车联网系统、数据平台及AI应用的开发与维护服务，保障系统稳定运行</span></div>
                <div class="service_content_box_platform_item_box">
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>海外车联网系统建设<br>与数据中心运维</h3>
                        <p><span>规划与搭建本地数据中心与车联网系统，<br>确保数据接入、传输与本地化部署顺畅可靠</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>测试车辆数据平台开发<br>(MDR 项目)</h3>
                        <p><span>提供从采集、传输、存储、可视化到企业用户接入<br>的测试车数据平台开发及集成服务</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>ADAS 路测数据采集<br>脱敏处理与传输回传</h3>
                        <p><span>针对ADAS系统提供专业数据采集方案，并进行隐<br>私处理与远程回传，支持算法训练与评估</span></p>
                    </div>
                    <div class="service_content_box_platform_item_box_item wow fadeInUp">
                        <h3>智能化服务平台的部署<br>与持续运维支持</h3>
                        <p><span>面向车企提供智能助手、座舱系统等模块的平台部<br>署服务与后期运维保障</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 03 -->
        <div id="service03" class="service_content_box service_content_box_tech">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">技术认证与合规服务</h2>
                <p><span class="service_content_box_subtitle wow fadeInUp">为主机厂提供全球法规适配、数据隐私合规和信息安全等支持，降低出海风险</span></p>
                <div class="service_content_box_tech_slider_box">
                    <div class="service_content_box_tech_slider_box_inner" id="techSliderImages">
                        <img class="active" src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_01.png" alt="" />
                        <img src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_02.png" alt="" />
                        <img src="/wp-content/themes/xetabyte_ver2/images/platform_service/tech_service_slider/item_03.png" alt="" />
                    </div>
                    <div class="service_content_box_tech_slider_box_navigation" id="techSliderNav">
                        <div class="service_content_box_tech_slider_box_navigation_item active">
                            <h3>欧盟GDPR合规整改<br>与系统优化</h3>
                            <p><span>针对欧盟GDPR法规，提供数据处理流程整改与系统加固方案，确保数据合规收集、传输与存储。</span></p>
                        </div>
                        <div class="service_content_box_tech_slider_box_navigation_item">
                            <h3>ISO 27001信息安全管理<br>体系认证</h3>
                            <p><span>建立完善的信息安全管理体系，通过ISO 27001认证，确保企业信息安全管理的规范化和标准化。</span></p>
                        </div>
                        <div class="service_content_box_tech_slider_box_navigation_item">
                            <h3>汽车网络安全<br>合规认证</h3>
                            <p><span>按照UNECE WP.29法规要求，提供汽车网络安全合规认证服务，确保车辆网络安全防护能力。</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 04 -->
        <div id="service04" class="service_content_box service_content_box_support">
            <div class="service_content_box_inner">
                <h2 class="service_content_box_title wow fadeInUp">市场与产品服务支持</h2>
                <div><span class="service_content_box_subtitle wow fadeInUp">结合用户与市场数据，为产品本地化、用户洞察及生态拓展提供支撑</span></div>
                <div class="service_content_box_support_item_box">
                    <div class="service_content_box_support_item_box_item wow fadeInUp">
                        <h3>海外用户调研<br>与产品体验测试</h3>
                        <p><span>组织真实用户测试与定性访谈，收集关键反馈，<br>助力产品在本地市场快速适配与优化</span></p>
                    </div>
                    <div class="service_content_box_support_item_box_right wow fadeInUp">
                        <div class="service_content_box_support_item_box_item">
                            <h3>智能化产品的<br>售前和售后服务</h3>
                            <p><span>提供不同国家/地区的市场准入分析、<br>销售通路建议与品牌本地化咨询服务</span></p>
                        </div>
                        <div class="service_content_box_support_item_box_item">
                            <h3>海外产业生态<br>合作拓展</h3>
                            <p><span>协助主机厂对接海外产业资源与技术标准组织，<br>推动建立稳定的国际合作机制与生态影响力</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部 Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">联系我们</h4>
                    <p>邮箱地址：<a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">商务合作</h4>
                    <p>邮箱地址：<a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>关注字特智能</h4>
                <div class="wechat_qrcode"></div>
                <p>官方微信</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">
                    Copyright © 2025-2026 字特智能科技（上海）有限公司 版权所有
                </p>
            </div>
        </div>
    </footer>

    <!-- 客户端交互 -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 语言切换
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            // 移动端菜单
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }

            // Service 03 轮播卡片交互
            const navItems = document.querySelectorAll('#techSliderNav .service_content_box_tech_slider_box_navigation_item');
            const sliderImgs = document.querySelectorAll('#techSliderImages img');
            navItems.forEach((nav, index) => {
                nav.addEventListener('click', () => {
                    navItems.forEach(el => el.classList.remove('active'));
                    sliderImgs.forEach(el => el.classList.remove('active'));
                    nav.classList.add('active');
                    if (sliderImgs[index]) sliderImgs[index].classList.add('active');
                });
            });
        });
    </script>
</body>
</html>
