---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>从中国走向世界！字特智能助力智能化汽车出海 - 字特智能</title>
    
    <link rel="icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="wp-singular post-template-default single single-post wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部导航栏 -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/wp-content/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li class="menu-item"><a href="/">首页</a></li>
                    <li class="menu-item"><a href="/核心产品/">核心产品</a></li>
                    <li class="menu-item"><a href="/数智化服务/">数智化服务</a></li>
                    <li class="menu-item current-menu-item"><a href="/资讯中心/">资讯中心</a></li>
                    <li class="menu-item"><a href="/关于我们/">关于我们</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/" selected>简体中文</option>
                        <option value="/en/">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page news_inner_page">
        <div class="news_page_header">
            <div class="news_page_header_inner">
                <h1 class="news_page_title">资讯中心</h1>
                <div class="news_category_navigation">
                    <a href="/资讯中心/" class="news_category_btn active">X NEWS</a>
                    <a href="/资讯中心/" class="news_category_btn">科技要闻</a>
                </div>
            </div>
        </div>

        <div class="news_article_header">
            <div class="news_article_header_inner">
                <h2 class="news_article_title">从中国走向世界！字特智能助力智能化汽车出海，为打造汽车强国贡献力量</h2>
                <div class="news_article_date">2024-11-18</div>
            </div>
        </div>
        
        <div class="news_brand_banner">
            <img src="/wp-content/themes/xetabyte_ver2/images/news_banner.png" alt="字特智能" />
        </div>

        <div class="news_content_section">
            <div class="news_content_section_inner">
                <article class="single_news_article">
                    <div class="single_news_content">
                        <p class="wp-block-paragraph">字特智能专注于为全球主机厂提供车联网系统部署、数据平台搭建与出海合规认证。随着智能化浪潮席卷全球，公司正稳步深化欧洲与南美业务布局。</p>
                        <div class="wp-block-image">
                            <figure class="aligncenter size-large">
                                <img src="/uploads/2025/09/640.png" alt="字特智能助力汽车出海" />
                            </figure>
                        </div>
                    </div>
                </article>
            </div>
        </div>

        <div class="news_pagination">
            <div class="news_pagination_inner">
                <div class="news_pagination_item news_pagination_prev">
                    <a href="/资讯中心/" class="news_pagination_link">&lt; 返回资讯列表</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">联系我们</h4>
                    <p>邮箱地址：<a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">商务合作</h4>
                    <p>邮箱地址：<a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>关注字特智能</h4>
                <div class="wechat_qrcode"></div>
                <p>官方微信</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">Copyright © 2025-2026 字特智能科技（上海）有限公司 版权所有</p>
            </div>
        </div>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }
        });
    </script>
</body>
</html>
