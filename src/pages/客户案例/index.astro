---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>核心产品 - 字特智能</title>
    <meta name="description" content="字特智能 - 核心产品。打造国际汽车智能化生态。">
    
    <link rel="icon" href="/uploads/2024/09/cropped-logo图形-彩色-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/uploads/2024/09/cropped-logo图形-彩色-180x180.png">
    
    <link rel="stylesheet" href="/wp-content/themes/xetabyte_ver2/animate.css?ver=4.1.1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>
<body class="wp-singular page-template page-template-page-products page-template-page-products-php page wp-custom-logo wp-theme-xetabyte_ver2">

    <!-- 顶部 Header -->
    <header class="top-header">
        <div class="header-inner">
            <a href="/" class="custom-logo-link" rel="home">
                <img width="264" height="64" src="/uploads/2025/08/cropped-logo.png" class="custom-logo" alt="字特智能" decoding="async" />
            </a>                
            
            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="切换菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
            
            <nav class="top-navi" id="topNavi">        
                <ul id="menu-new_main_menu" class="menu">
                    <li class="menu-item"><a href="/">首页</a></li>
                    <li class="menu-item current-menu-item current_page_item"><a href="/核心产品/" aria-current="page">核心产品</a></li>
                    <li class="menu-item"><a href="/数智化服务/">数智化服务</a></li>
                    <li class="menu-item"><a href="/资讯中心/">资讯中心</a></li>
                    <li class="menu-item"><a href="/关于我们/">关于我们</a></li>
                </ul> 
            </nav>
            
            <div id="language_box_wrapper">
                <span class="language_label">语言/Languages:</span>
                <div id="language_box">
                    <select name="lang_choice_1" id="lang_choice_1" class="pll-switcher-select">
                        <option value="/核心产品/" selected>简体中文</option>
                        <option value="/en/xeta-products/">English</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <div class="inner_page">
        <!-- 页面顶部 Banner -->
        <div class="inner_page_intro_box" style="background-image: url('/uploads/2025/09/核心产品banner-scaled.jpg');">
            <div class="inner_page_intro_box_inner">
                <h1 class="inner_page_intro_box_title wow fadeInUp">核心产品</h1>
                <span class="inner_page_intro_box_subtitle wow fadeInUp">打造国际汽车智能化生态</span>
            </div>
        </div>

        <div class="inner_page_content">
            <!-- 产品 01: AI 汽车智能管家 -->
            <div id="product01" class="main_product_slider_box">
                <div class="main_product_slider_box_title wow fadeInUp">
                    <h2>AI 汽车智能管家<br>XETA Auto AI Agent</h2>
                    <p>基于大语言模型的智能交互助手，打造个性化车载交互体验</p>
                </div>
                <div class="main_product_slider_box_inner">
                    <div class="main_product_slider_box_inner_item active"></div>
                    <div class="main_product_slider_box_inner_item"></div>
                </div>
                <ul class="main_product_slider_box_navigation">
                    <li class="active"></li>
                    <li></li>
                </ul>
            </div>
            
            <div class="main_product_slider_box_content">
                <div class="main_product_slider_box_content_inner">
                    <p class="wow fadeInUp">
                        基于大语言模型构建的车载智能交互系统，<br>
                        具备自然语言理解、上下文记忆、主动推荐、语音控制等功能，<br>
                        为用户带来更安全、高效、个性化的智能座舱体验。<br>
                        AI 助手可与导航、娱乐、空调、车辆状态等系统无缝集成，<br>
                        是字特智能面向下一代智能车的核心用户入口。
                    </p>
                    <div class="main_product_slider_box_content_inner_item_box">
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>智能体验</h3>
                            <p>用户可感知的智能体验核心</p>
                        </div>
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>自定义</h3>
                            <p>支持自定义品牌形象和语音风格</p>
                        </div>
                        <div class="main_product_slider_box_content_inner_item_box_item wow fadeInUp">
                            <h3>系统适配</h3>
                            <p>已适配主流操作系统与硬件平台</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 产品 02: 汽车数智化平台 -->
            <div id="product02" class="main_product_content_box">
                <div class="main_product_content_box_inner">
                    <h2 class="wow fadeInUp">汽车数智化平台<br>XETA Auto AI Platform</h2>
                    <div>
                        <span class="wow fadeInUp">联通数据、模型与智能应用，构建面向整车的智能系统平台</span><br>
                        <img class="main_product_content_box_inner_img wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/main_product/main_product_content_img.png" alt="汽车数智化平台" />
                    </div>
                    <p class="wow fadeInUp">
                        聚焦智能汽车核心三层能力，联通数据中间件、模型中间件与应用中间件，<br>
                        为主机厂提供智能座舱系统、AI助手集成、模型接入与运行环境等关键模块，<br>
                        支持跨平台部署和定制化交付，<br>
                        帮助企业搭建具备可持续演进能力的智能系统基础设施。
                    </p>
                    <div class="main_product_content_box_inner_feature">
                        <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                            <h3>联通数据</h3>
                            <div><span>联通数据、模型与智能应用，构建面向整车的智能系统集成框架</span></div>
                        </div>
                        <div class="main_product_content_box_inner_feature_right">
                            <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                                <h3>多模型部署</h3>
                                <div><span>支持多模型部署、调度与更新，满足大模型在车端的运行与管理需求</span></div>
                            </div>
                            <div class="main_product_content_box_inner_feature_item wow fadeInUp">
                                <h3>快速集成</h3>
                                <div><span>座舱与服务应用的快速集成环境，简化语音助手、交互系统等模块上线流程</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部 Footer -->
    <footer class="footer">
        <div class="footer_inner">
            <div class="footer_inner_left">
                <div class="content">
                    <h4 class="title">联系我们</h4>
                    <p>邮箱地址：<a href="mailto:info@xetabyte.ai">info@xetabyte.ai</a></p>
                </div>
                <div class="content">
                    <h4 class="title">商务合作</h4>
                    <p>邮箱地址：<a href="mailto:business@xetabyte.ai">business@xetabyte.ai</a></p>
                </div>
            </div>
            <div class="footer_inner_right">
                <h4>关注字特智能</h4>
                <div class="wechat_qrcode"></div>
                <p>官方微信</p>
            </div>
        </div>
        <div class="footer_bottom">
            <div class="footer_bottom_inner">
                <p class="left">
                    Copyright © 2025-2026 字特智能科技（上海）有限公司 版权所有
                </p>
            </div>
        </div>
    </footer>

    <!-- 客户端脚本 -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const langSelect = document.getElementById('lang_choice_1');
            if (langSelect) {
                langSelect.addEventListener('change', (e) => {
                    window.location.href = e.target.value;
                });
            }

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const topNavi = document.getElementById('topNavi');
            if (mobileMenuBtn && topNavi) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuBtn.classList.toggle('active');
                    topNavi.classList.toggle('mobile-open');
                    document.body.classList.toggle('menu-open');
                });
            }
        });
    </script>
</body>
</html>
