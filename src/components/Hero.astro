---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
---

<div class="home_page_banner">
  <div class="home_page_banner_mask"></div>
  <video class="wow fadeInUp" src="/wp-content/themes/xetabyte_ver2/images/top_movie.mp4" autoplay muted loop playsinline poster="/wp-content/themes/xetabyte_ver2/images/top_movie.jpg"></video>
  <div class="home_page_banner_content wow fadeInUp home_page_banner_content_text">
    <h1>{isEn ? "Make Mobility Space Smarter" : "让出行空间更智能"}</h1>
    <span>{isEn ? "Building the Next-Gen Automotive Intelligence Ecosystem" : "Make Mobility Space Smarter"}</span>
  </div>
</div>
