<section class="home_page_part" id="line3">
  <div class="about_page_header">
    <div class="about_page_header_inner">
      <h1>关于字特智能</h1>
      <span>字特智能致力于通过软硬件一体的智能化基础设施，全面赋能汽车产业数字化转型。</span>

      <div class="about_page_header_inner_item_box">
        <div class="about_page_header_inner_item_box_item" style="background-image: url('/images/about_item1.jpg');">
          <h3>全球化生态布局</h3>
          <span>跨国研发协作与供应链覆盖</span>
        </div>
        <div class="about_page_header_inner_item_box_item" style="background-image: url('/images/about_item2.jpg');">
          <h3>全栈自研技术</h3>
          <span>核心算法与操作系统完全可控</span>
        </div>
        <div class="about_page_header_inner_item_box_item" style="background-image: url('/images/about_item3.jpg');">
          <h3>车规级安全认证</h3>
          <span>遵循 ISO 26262 最高安全标准</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 联系我们 -->
<section class="home_page_part_contact_us" id="contact">
  <div class="home_page_part_contact_us_inner">
    <div class="home_page_part_contact_us_inner_box">
      <div class="home_page_part_contact_us_inner_box_intro">
        <h2>联系我们</h2>
        <span>CONTACT US FOR BUSINESS COOPERATION</span>
      </div>

      <div class="home_page_part_contact_us_inner_box_form">
        <div class="form_title">
          <span>COOPERATION FORM</span>
        </div>
        <form class="form_body">
          <input type="text" placeholder="您的姓名" required />
          <input type="email" placeholder="电子邮箱" required />
          <input type="tel" placeholder="联系电话" required />
          <input type="text" placeholder="公司名称" />
          <input type="submit" class="submit" value="提交意向" />
        </form>
      </div>
    </div>
  </div>
</section>
